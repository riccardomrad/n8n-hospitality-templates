    {
      "parameters": {
        "jsCode": "// MAP - Parse WhatsApp incoming message/button reply\n// Handles: quick reply buttons, text messages\n\nconst input = $input.first().json;\n\n// Meta webhook structure: entry[].changes[].value.messages[]\nconst entry = input.entry?.[0];\nconst changes = entry?.changes?.[0];\nconst value = changes?.value;\nconst message = value?.messages?.[0];\nconst contact = value?.contacts?.[0];\n\nif (!message) {\n  // Not a message event (could be status update)\n  return [{ json: { event_type: 'status_update', skip: true } }];\n}\n\nconst phone = message.from; // E.164 without +\nconst phoneE164 = '+' + phone;\nconst messageType = message.type;\n\nlet replyAction = 'unknown';\nlet replyText = '';\n\n// Quick reply button\nif (messageType === 'button') {\n  replyText = message.button?.text || '';\n  const textLower = replyText.toLowerCase();\n  if (textLower.includes('conferm')) replyAction = 'confirm';\n  else if (textLower.includes('cancel') || textLower.includes('annul')) replyAction = 'cancel';\n  else if (textLower.includes('modif') || textLower.includes('cambi')) replyAction = 'modify';\n}\n// Interactive list/button reply\nelse if (messageType === 'interactive') {\n  const interactive = message.interactive;\n  if (interactive?.type === 'button_reply') {\n    replyText = interactive.button_reply?.title || '';\n    const id = interactive.button_reply?.id || '';\n    if (id === 'confirm' || replyText.toLowerCase().includes('conferm')) replyAction = 'confirm';\n    else if (id === 'cancel' || replyText.toLowerCase().includes('cancel')) replyAction = 'cancel';\n    else if (id === 'modify' || replyText.toLowerCase().includes('modif')) replyAction = 'modify';\n  }\n}\n// Free text\nelse if (messageType === 'text') {\n  replyText = message.text?.body || '';\n  const textLower = replyText.toLowerCase();\n  if (textLower.includes('conferm') || textLower === 'si' || textLower === 'ok') replyAction = 'confirm';\n  else if (textLower.includes('cancel') || textLower.includes('annul') || textLower === 'no') replyAction = 'cancel';\n  else if (textLower.includes('modif') || textLower.includes('cambi') || textLower.includes('spost')) replyAction = 'modify';\n  else replyAction = 'free_text';\n}\n\nreturn [{\n  json: {\n    event_type: 'message',\n    skip: false,\n    phone_e164: phoneE164,\n    contact_name: contact?.profile?.name || '',\n    message_type: messageType,\n    reply_action: replyAction,\n    reply_text: replyText,\n    message_id: message.id,\n    timestamp: message.timestamp,\n    received_at: new Date().toISOString()\n  }\n}];"
      },
      "name": "MAP - Parse Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
